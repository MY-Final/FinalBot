# FinalBot server
FINALBOT_HOST=127.0.0.1
FINALBOT_PORT=8787
FINALBOT_DATA_DIR=./data
FINALBOT_LOG_LEVEL=info
# Required when FINALBOT_HOST is not a loopback address.
FINALBOT_ADMIN_TOKEN=

# A repository FinalBot is allowed to run coding agents in.
# This path is the repository root, not a random directory.
FINALBOT_REPO_PATH=D:\WorkSpace\your-project

# Set to 1 to exercise UI and state persistence without Codex.
FINALBOT_FAKE_AGENT=0

# OneBot v11 forward WebSocket exposed by NapCat.
# Example: ws://192.168.1.20:3001
NAPCAT_WS_URL=
NAPCAT_ACCESS_TOKEN=
NAPCAT_ACCOUNT_ID=
# Comma-separated QQ numbers allowed to use FinalBot through private chat.
# Empty means all private messages are rejected.
NAPCAT_PRIVATE_USER_IDS=
# Comma-separated QQ numbers that must never reach the agent, including other bots.
NAPCAT_IGNORED_USER_IDS=
# Group messages must mention this account before they reach the agent.
NAPCAT_GROUP_REQUIRE_MENTION=1

# QQ official bot. Only C2C private chat and GROUP_AT_MESSAGE_CREATE are
# supported. The platform does not allow proactive messages to these targets.
FINALBOT_QQ_ENABLED=0
FINALBOT_QQ_APP_ID=
FINALBOT_QQ_APP_SECRET=
# Optional overrides for deterministic testing or a compatible proxy.
FINALBOT_QQ_TOKEN_URL=
FINALBOT_QQ_API_BASE_URL=
FINALBOT_QQ_GATEWAY_URL=

# Codex app-server executable. Defaults to "codex" on PATH.
FINALBOT_CODEX_BIN=codex
FINALBOT_CODEX_MODEL=
FINALBOT_CODEX_SANDBOX=workspace-write

# Maximum number of agent runs that may execute concurrently.
FINALBOT_MAX_CONCURRENT_RUNS=2

